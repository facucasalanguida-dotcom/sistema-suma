# ───────────────────────────────────────────────────────────────────────────
# Inteligencia artificial (Google Gemini)
# ───────────────────────────────────────────────────────────────────────────
# Sin clave, el sistema arranca igualmente en MODO DEMOSTRACIÓN: responde con
# un catálogo local de materiales y precios orientativos de Málaga. Con clave,
# interpreta fotografías y busca tarifas reales en Internet.
#
# Se obtiene gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelos. Se dejan configurables porque el catálogo de Google cambia varias
# veces al año, y un modelo apagado deja el sistema sin servicio de un día para
# otro. Situación comprobada en agosto de 2026:
#
#   gemini-3.6-flash      Valor por defecto. Es el sucesor que Google señala
#                         para gemini-2.5-flash, cuyo apagado está anunciado
#                         para octubre de 2026.
#   gemini-3.7-flash      El más reciente de la familia flash.
#   gemini-3.1-flash-lite Multimodal, 1M de contexto y bastante más barato.
#                         Buena opción para GEMINI_UTILITY_MODEL, que sólo
#                         estructura JSON y parsea frases de cantidad.
#   gemini-flash-latest   Alias que sigue siempre al modelo flash vigente: no
#                         caduca nunca, a cambio de que su comportamiento pueda
#                         cambiar sin avisar.
#
# Los valores por defecto priorizan la calidad de lectura de las fotografías y
# de los datos de proveedor, que es donde un error sale caro. Si el volumen
# aprieta, el primer cambio rentable es el modelo de utilidad.
GEMINI_VISION_MODEL=gemini-3.6-flash
GEMINI_SEARCH_MODEL=gemini-3.6-flash
GEMINI_UTILITY_MODEL=gemini-3.6-flash

# Presupuesto de tiempo para TODA una petición a la IA, en milisegundos —no por
# llamada: una búsqueda encadena dos. Debe quedar por debajo del límite de la
# función que lo ejecuta (60 s en el plan gratuito de Vercel) para que la
# aplicación conteste antes de que la plataforma corte.
GEMINI_TIMEOUT_MS=50000

# ───────────────────────────────────────────────────────────────────────────
# Datos del emisor que aparecen en el presupuesto
# ───────────────────────────────────────────────────────────────────────────
# Llevan el prefijo NEXT_PUBLIC_ porque también se muestran en la interfaz.
# Sustituye los valores por los reales antes de emitir un presupuesto a un
# cliente: los que trae el código son marcadores de posición evidentes.
NEXT_PUBLIC_SUMA_LEGAL_NAME=Grupo SUMA
NEXT_PUBLIC_SUMA_TAX_ID=B00000000
NEXT_PUBLIC_SUMA_ADDRESS=Málaga, España
NEXT_PUBLIC_SUMA_EMAIL=info@gruposuma.eu
NEXT_PUBLIC_SUMA_PHONE=+34 000 000 000
NEXT_PUBLIC_SUMA_WEBSITE=www.gruposuma.eu

# Datos registrales para el pie del PDF (art. 24 del Código de Comercio).
# Ejemplo: Inscrita en el Registro Mercantil de Málaga, Tomo 1234, Folio 56, Hoja MA-78901
NEXT_PUBLIC_SUMA_REGISTRY=

# ───────────────────────────────────────────────────────────────────────────
# Búsqueda programática (opcional): más opciones aún, con la API de Google
# ───────────────────────────────────────────────────────────────────────────
# Además del grounding de Gemini, el sistema puede consultar la API oficial de
# Google Custom Search para encontrar más fichas de producto con URL literal.
# Es la alternativa robusta al scraping del buscador, que Google bloquea y
# prohíbe. Sin estas variables la capa se desactiva sola y todo sigue igual.
#
#  1. Crea un buscador en https://programmablesearchengine.google.com
#     añadiendo las tiendas como sitios (*.obramat.es, *.leroymerlin.es,
#     *.manomano.es, *.bauhaus.es, *.bricodepot.es…) y copia su ID.
#     «Buscar en toda la web» también vale: el sistema filtra igualmente a
#     dominios de tiendas reales, pero la lista aprovecha mejor la cuota.
#  2. En Google Cloud, activa «Custom Search API» y crea una clave de API.
#
# Cuota: 100 consultas/día gratis; después ~5 USD por cada 1.000.
#
# Con estas variables activas, cada búsqueda además LEE EN VIVO las webs de
# las principales tiendas (Obramat, Leroy Merlin, ManoMano, Bauhaus, Brico
# Depot): busca el material en cada una, descarga sus fichas y usa los
# precios publicados hoy. Ojo con la cuota: cada búsqueda del chat consume
# varias consultas de la API (una por tienda más las generales).
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# Tiendas adicionales para la lectura en vivo, separadas por comas
# (p. ej. «isolana.es, tutiendafavorita.com»). Opcional.
SUMA_EXTRA_SHOPS=

# ───────────────────────────────────────────────────────────────────────────
# Acceso con cuentas: usuario, contraseña, segundo factor y Google
# ───────────────────────────────────────────────────────────────────────────
# Este es el sistema de acceso nuevo. Mientras SESSION_SECRET esté vacía sigue
# funcionando la contraseña compartida de abajo, así que se puede activar sin
# prisa y sin quedarse fuera.
#
# PASO 1 · La clave que firma las sesiones. Genérala con:
#     openssl rand -base64 32
# Mínimo 32 caracteres. Si cambia, todo el mundo tiene que volver a entrar.
SESSION_SECRET=

# PASO 2 · Las cuentas. NO se escribe a mano: entra en /acceso/alta, rellena
# el formulario y la pantalla te da este valor ya hecho para pegar aquí.
# Contiene el hash de cada contraseña (scrypt) y el secreto de cada segundo
# factor; nunca contraseñas en claro.
SUMA_USUARIOS=

# Interruptor de emergencia: cambia este número (a 2, a 3…) y todas las
# sesiones abiertas dejan de valer al instante. Úsalo si sospechas que alguien
# ha entrado sin permiso.
AUTH_TOKEN_VERSION=1

# ───────────────────────────────────────────────────────────────────────────
# Entrar con Google (opcional, y la forma más segura)
# ───────────────────────────────────────────────────────────────────────────
# Con esto no hay contraseñas que recordar ni que robar: de la identidad y del
# doble factor se encarga Google, y aquí sólo se comprueba que el correo esté
# en la lista de autorizados.
#
# En https://console.cloud.google.com → APIs y servicios → Credenciales:
#   1. Configura la «pantalla de consentimiento» como Interna o Externa.
#   2. Crea un «ID de cliente de OAuth» de tipo «Aplicación web».
#   3. En «URIs de redireccionamiento autorizados» añade EXACTAMENTE:
#        https://TU-DOMINIO/api/auth/google/callback
#   4. Copia el ID y el secreto aquí abajo.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Correos que pueden entrar con Google, separados por comas.
SUMA_CORREOS_PERMITIDOS=

# Dirección pública de la aplicación, sin barra final. Sólo hace falta si usas
# un dominio propio; si no, se deduce sola de la petición.
SUMA_URL_PUBLICA=

# ───────────────────────────────────────────────────────────────────────────
# Acceso (opcional, recomendable en producción)
# ───────────────────────────────────────────────────────────────────────────
# Contraseña compartida de siempre. Sigue valiendo mientras no configures
# SESSION_SECRET; a partir de ahí sólo sirve para crear la primera cuenta en
# /acceso/alta.
# Una vez desplegada, la aplicación queda en una URL pública y cualquiera que
# la encuentre puede lanzar búsquedas que se facturan contra vuestra clave de
# Gemini. Con esta variable, el navegador pide una contraseña compartida antes
# de dejar entrar. Si se deja vacía, no hay puerta.
SUMA_ACCESS_PASSWORD=
