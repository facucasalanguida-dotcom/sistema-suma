# ───────────────────────────────────────────────────────────────────────────
# Inteligencia artificial (Google Gemini)
# ───────────────────────────────────────────────────────────────────────────
# Sin clave, el sistema arranca igualmente en MODO DEMOSTRACIÓN: responde con
# un catálogo local de materiales y precios orientativos de Málaga. Con clave,
# interpreta fotografías y busca tarifas reales en Internet.
#
# Se obtiene gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelos. Se dejan configurables porque el catálogo de Google cambia varias
# veces al año: `gemini-2.5-flash` tiene apagado anunciado para octubre de 2026
# y `gemini-3.6-flash` es su sucesor. `gemini-flash-latest` apunta siempre al
# modelo flash vigente, a cambio de que su comportamiento pueda variar.
GEMINI_VISION_MODEL=gemini-3.6-flash
GEMINI_SEARCH_MODEL=gemini-3.6-flash
GEMINI_UTILITY_MODEL=gemini-3.6-flash

# Tiempo máximo por llamada al modelo, en milisegundos.
GEMINI_TIMEOUT_MS=60000

# ───────────────────────────────────────────────────────────────────────────
# Datos del emisor que aparecen en el presupuesto
# ───────────────────────────────────────────────────────────────────────────
# Llevan el prefijo NEXT_PUBLIC_ porque también se muestran en la interfaz.
# Sustituye los valores por los reales antes de emitir un presupuesto a un
# cliente: los que trae el código son marcadores de posición evidentes.
NEXT_PUBLIC_SUMA_LEGAL_NAME=Grupo SUMA
NEXT_PUBLIC_SUMA_TAX_ID=B00000000
NEXT_PUBLIC_SUMA_ADDRESS=Málaga, España
NEXT_PUBLIC_SUMA_EMAIL=info@gruposuma.eu
NEXT_PUBLIC_SUMA_PHONE=+34 000 000 000
NEXT_PUBLIC_SUMA_WEBSITE=www.gruposuma.eu

# Datos registrales para el pie del PDF (art. 24 del Código de Comercio).
# Ejemplo: Inscrita en el Registro Mercantil de Málaga, Tomo 1234, Folio 56, Hoja MA-78901
NEXT_PUBLIC_SUMA_REGISTRY=
